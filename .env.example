# Salin menjadi ".env" (lokal) atau isi di Vercel -> Settings -> Environment Variables.
# File ".env" jangan diupload ke GitHub (sudah diabaikan .gitignore).

# WAJIB - connection string Pooled dari Neon (Dashboard Neon -> Connect -> Pooled)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# WAJIB - kata sandi masuk aplikasi (minimal 4 karakter)
APP_PASSWORD=ganti-dengan-sandi-kuat

# OPSIONAL - pengacak tanda tangan sesi (teks acak panjang)
# SESSION_SECRET=

# OPSIONAL - kunci halaman /api/setup
# SETUP_TOKEN=kata-rahasia-anda
